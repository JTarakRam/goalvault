PORT=4000
# HMAC secret shared with the payment provider for webhook signatures.
WEBHOOK_SECRET=change-me-in-production
# Secret used to sign session tokens.
SESSION_SECRET=change-me-too
# sandbox | razorpay (production adapter must be implemented against a licensed PA/bank)
PAYMENT_PROVIDER=sandbox
# How often the debit scheduler runs, in ms.
SCHEDULER_INTERVAL_MS=30000
